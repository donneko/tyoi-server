---
import "../styles/panel.css";
---

<!doctype html>
<html lang="ja">
    <head
        ><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>
            Status
        </title></head
    >
    <body>
        <h1>Server Status</h1><div id="connection">connecting</div>
        <div class="card">
            <dl>
                <dt>State</dt><dd id="state">-</dd><dt>Port</dt><dd id="port">-</dd><dt>
                    Uptime
                </dt><dd id="uptime">-</dd><dt>Updated</dt><dd id="updated">-</dd>
            </dl>
        </div>
        <script>
            import { createApiClient } from "../client/api/create-api-client";
            import { startStatusPage } from "../client/pages/status";
            import { connectUpdates } from "../client/realtime/connect-updates";
            const api = createApiClient({ fetch, baseUrl: `${import.meta.env.BASE_URL}api` });
            const socketUrl = new URL(`${import.meta.env.BASE_URL}ws`, window.location.href);
            socketUrl.protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
            startStatusPage(document, api, (options) =>
                connectUpdates({
                    ...options,
                    url: socketUrl.href,
                    WebSocket,
                    setTimeout,
                    clearTimeout,
                })
            );
        </script>
    </body>
</html>
